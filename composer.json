{
  "name": "astral-php/astral-form",
  "version": "0.1.0",
  "description": "Form helpers and partials for Astral MVC.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "astral",
    "php",
    "form",
    "validator",
    "tailwind"
  ],
  "require": {
    "php": "^8.0",
    "astral-php/astral": "^1.1"
  },
  "require-dev": {
